{
  "nodes": [
    { "id": "grp-docs", "type": "group", "label": "Read in order", "x": -160, "y": -640, "width": 1360, "height": 200 },
    { "id": "moc",  "type": "file", "file": "ArbModelV2_Plans/_MOC - ArbModel V2.md", "x": -140, "y": -600, "width": 300, "height": 140 },
    { "id": "n01",  "type": "file", "file": "ArbModelV2_Plans/01 - Current Model - How It Works.md", "x": 200, "y": -600, "width": 300, "height": 140 },
    { "id": "n02",  "type": "file", "file": "ArbModelV2_Plans/02 - Weaknesses and Lessons.md", "x": 540, "y": -600, "width": 300, "height": 140 },
    { "id": "n03",  "type": "file", "file": "ArbModelV2_Plans/03 - V2 Build Instructions.md", "x": 880, "y": -600, "width": 300, "height": 140 },

    { "id": "idea", "type": "text", "x": 200, "y": -380, "width": 640, "height": 110, "color": "1",
      "text": "## The one idea\nV1's math was honest, but the **money-booking paths ignored detection's safeguards**. V2 = **one eligibility predicate enforced at every stage**." },

    { "id": "grp-roles", "type": "group", "label": "Model roles", "x": -420, "y": -180, "width": 320, "height": 780 },
    { "id": "fable",  "type": "text", "x": -400, "y": -140, "width": 280, "height": 150, "color": "5",
      "text": "### 🧠 Fable 5 — PLAN\nMethodology & math: de-vig / calibration, `p̂` uncertainty, pre-registration, friction formulas." },
    { "id": "opus",   "type": "text", "x": -400, "y": 40, "width": 280, "height": 150, "color": "6",
      "text": "### 🧠 Opus 4.8 — PLAN\nArchitecture & spec: eligibility predicate, `position_key`, config + DB schema, capacity honesty." },
    { "id": "coder",  "type": "text", "x": -400, "y": 220, "width": 280, "height": 150, "color": "4",
      "text": "### ⌨️ Cheaper coder — CODE\nImplements from a frozen spec + failing tests. **May not edit a test vector.**" },
    { "id": "verify", "type": "text", "x": -400, "y": 400, "width": 280, "height": 150, "color": "1",
      "text": "### 🔍 Opus 4.8 / Fable 5 — VERIFY\nDiff audit vs weaknesses list. Phase-6 money-path proof: a REVIEW arb can never reach clean P&L." },

    { "id": "found", "type": "text", "x": 40, "y": -140, "width": 340, "height": 150, "color": "2",
      "text": "### Foundational (before Phase 1)\n🧠 PLAN only — F1 SPEC_V2 · F2 eligibility · F3 position_key · F4 de-vig/calibration · F5 friction · F6 capacity honesty · F7 pre-registration." },

    { "id": "p1", "type": "text", "x": 440, "y": -140, "width": 300, "height": 90, "color": "3", "text": "**Phase 1 — Skeleton & config**\n🧠 schema/signatures → ⌨️ build → 🔍" },
    { "id": "p2", "type": "text", "x": 440, "y": -30,  "width": 300, "height": 90, "color": "3", "text": "**Phase 2 — Math core**\n🧠 freeze vectors → ⌨️ implement → 🔍 (Decimal, edge_points)" },
    { "id": "p3", "type": "text", "x": 440, "y": 80,   "width": 300, "height": 90, "color": "3", "text": "**Phase 3 — Venue adapters**\nfixtures-first; normalized depth; SX inversion test → 🔍" },
    { "id": "p4", "type": "text", "x": 440, "y": 190,  "width": 300, "height": 90, "color": "3", "text": "**Phase 4 — Matching**\ndoubleheader clustering; suspect rows written → 🔍" },
    { "id": "p5", "type": "text", "x": 440, "y": 300,  "width": 300, "height": 90, "color": "3", "text": "**Phase 5 — Detection**\neligibility at detection; linear neg-risk fee → 🔍 same predicate reused" },
    { "id": "p6", "type": "text", "x": 440, "y": 410,  "width": 300, "height": 110, "color": "1", "text": "**Phase 6 — Ledger / settle / reconcile** ⚠️\nshared eligibility (A1), timing guard (A3), multi-venue reconcile (A2). **Verify hardest here.**" },
    { "id": "p7", "type": "text", "x": 440, "y": 540,  "width": 300, "height": 90, "color": "3", "text": "**Phase 7 — EV path**\ncalibrated p̂, edge/SE gate, CLV vs no-vig mid. EV stays disabled." },
    { "id": "p8", "type": "text", "x": 440, "y": 650,  "width": 300, "height": 90, "color": "3", "text": "**Phase 8 — Capacity / exposure / theses**\ncapacity = UNKNOWN until real ladders." },

    { "id": "gate", "type": "text", "x": 820, "y": 410, "width": 340, "height": 130, "color": "1",
      "text": "## 🚩 Project acceptance gate\nOne strong-model VERIFY proves: the **same eligibility predicate** gates detection, fill, settle, reconcile, capacity, exposure — with a test that a REVIEW arb never reaches headline P&L." }
  ],
