# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Database (240MB+) and its WAL/SHM sidecars — never enter history
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/.fuse_hidden*

# Local runtime artifacts
logs/
reports/daily/*.csv
reports/daily/*.md
reports/dashboard.json
data/test_baseline.txt
data/stop-*
data/*.meta
# Machine-written lived-settlement observations (rebuildable from the ledger via `arb reconcile`)
data/settlement_matrix_observed.yaml

# Read-only V1 archive DB (3GB+) — oracle data, never in history
data/archive-pre-v2/

# Local config overrides (may hold machine-specific values)
config.local.yaml
config.local.yaml.bak

# macOS
.DS_Store
**/.DS_Store

# Kept intentionally (small seed/config files, NOT ignored):
#   .env.example, data/aliases.json, data/*_series.json, data/nonsports_map.yaml

# Claude Code local settings (may record commands/keys)
.claude/
**/.claude/

# Obsidian vault workspace/cache (repo doubles as a vault)
.obsidian/
